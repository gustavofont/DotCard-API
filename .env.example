# Application
APP_NAME=DotCard-API
PORT=3001
NODE_ENV=development

# CORS - comma separated list of allowed origins, or * for any
CORS_ORIGINS=*

# Database — Postgres "dotcard". Outside Docker: localhost:5433 (5432 is
# already used by authforge-postgres). Inside the Docker network, the root
# compose overrides POSTGRES_HOST/PORT to the internal service/port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=dotcard
POSTGRES_PASSWORD=dotcard
POSTGRES_DB=dotcard

# JWT — local validation, HS256 by default. MUST be identical to the
# JWT_SECRET in services/auth-forge/.env, otherwise no token issued by
# AuthForge will validate here. To switch to RS256, fill in JWT_PUBLIC_KEY
# (AuthForge's PUBLIC key — DotCard never needs the private one, it only
# validates, never signs) and leave JWT_SECRET empty.
JWT_SECRET=change-me-to-the-same-value-as-authforge-jwt-secret
JWT_PUBLIC_KEY=

# RabbitMQ — shared broker; DotCard-API is only a producer, publishing to
# MailForge's mail.queue. Outside Docker: localhost:5672. Inside the Docker
# network, the root compose overrides this to amqp://guest:guest@rabbitmq:5672.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MinIO / S3-compatible storage — card images.
# STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY must match MINIO_ROOT_USER/PASSWORD
# below. Outside Docker: localhost:9000. Inside the Docker network, the root
# compose overrides STORAGE_ENDPOINT to http://minio:9000.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=dotcard
STORAGE_SECRET_KEY=change-me-minio-secret
STORAGE_BUCKET=dotcard-cards
STORAGE_REGION=us-east-1

# MinIO — credentials for the container itself (used only by the root
# docker-compose.yml to bootstrap the "minio" service). Keep identical to
# STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY above.
MINIO_ROOT_USER=dotcard
MINIO_ROOT_PASSWORD=change-me-minio-secret
